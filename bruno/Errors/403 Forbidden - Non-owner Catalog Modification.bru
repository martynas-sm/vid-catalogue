meta {
  name: 403 Forbidden - Non-owner Catalog Modification
  type: http
  seq: 8
  tags: [
    Errors
  ]
}

put {
  url: {{baseUrl}}/catalogs/:catalog_id
  body: json
  auth: inherit
}

params:path {
  catalog_id: 1
}

headers {
  Authorization: Bearer {{creator_token}}
}

body:json {
  {
    "name": "Tampered Catalog",
    "description": "Attempting to modify someone else's catalog",
    "is_public": true
  }
}

assert {
  res.status: eq 403
}

docs {
  Demonstrates 403 Forbidden when an authenticated user attempts to modify or replace a catalog owned by another user.
}
