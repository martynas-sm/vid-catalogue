meta {
  name: Replace a video by ID within a catalog
  type: http
  seq: 4
  tags: [
    Videos
  ]
}

put {
  url: {{baseUrl}}/catalogs/:catalog_id/videos/:video_id
  body: json
  auth: inherit
}

params:path {
  catalog_id: 1
  video_id: 1
}

body:json {
  {
    "title": "The determinant (Deep Dive) | Essence of linear algebra, chapter 6",
    "url": "https://www.youtube.com/watch?v=Ip3X9LOh2dk",
    "duration": 603.0,
    "description": "The geometric view of linear transformations and how area scaling factor relates to determinants."
  }
}

example {
  name: 200 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/catalogs/:catalog_id/videos/:video_id
    method: PUT
    mode: json
    params:path: {
      catalog_id: 
      video_id: 
    }
  
    body:json: {
      {
        "title": "",
        "url": "",
        "duration": 0,
        "description": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "title": "",
          "url": "",
          "duration": 0,
          "description": "",
          "id": 0,
          "catalog_id": 0,
          "created_at": "",
          "updated_at": "",
          "links": {}
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Catalog or video not found
  
  request: {
    url: {{baseUrl}}/catalogs/:catalog_id/videos/:video_id
    method: PUT
    mode: json
    params:path: {
      catalog_id: 
      video_id: 
    }
  
    body:json: {
      {
        "title": "",
        "url": "",
        "duration": 0,
        "description": ""
      }
    }
  }
  
  response: {
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 422 Response
  description: Validation Error
  
  request: {
    url: {{baseUrl}}/catalogs/:catalog_id/videos/:video_id
    method: PUT
    mode: json
    params:path: {
      catalog_id: 
      video_id: 
    }
  
    body:json: {
      {
        "title": "",
        "url": "",
        "duration": 0,
        "description": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": [
            {
              "loc": [],
              "msg": "",
              "type": "",
              "input": "",
              "ctx": {}
            }
          ]
        }
      '''
    }
  }
}
