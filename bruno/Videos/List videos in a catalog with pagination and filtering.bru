meta {
  name: List videos in a catalog with pagination and filtering
  type: http
  seq: 1
  tags: [
    Videos
  ]
}

get {
  url: {{baseUrl}}/catalogs/:catalog_id/videos
  body: none
  auth: inherit
}

params:query {
  limit: 10
  offset: 0
  ~title: determinant
}

params:path {
  catalog_id: 1
}

example {
  name: 200 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/catalogs/:catalog_id/videos
    method: GET
    mode: none
    params:query: {
      limit: 10
      offset: 0
      ~title: 
    }
  
    params:path: {
      catalog_id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "videos": [
            {
              "title": "",
              "url": "",
              "duration": 0,
              "description": "",
              "id": 0,
              "catalog_id": 0,
              "created_at": "",
              "updated_at": "",
              "links": {}
            }
          ],
          "pagination": {
            "limit": 0,
            "offset": 0,
            "total": 0
          },
          "links": {}
        }
      '''
    }
  }
}

