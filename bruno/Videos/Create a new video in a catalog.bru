meta {
  name: Create a new video in a catalog
  type: http
  seq: 2
  tags: [
    Videos
  ]
}

post {
  url: {{baseUrl}}/catalogs/:catalog_id/videos
  body: json
  auth: inherit
}

params:path {
  catalog_id: 1
}

body:json {
  {
    "title": "Eigenvectors and eigenvalues | Essence of linear algebra, chapter 14",
    "url": "https://www.youtube.com/watch?v=PFDu9oVAE-g",
    "duration": 1033.0,
    "description": "Visualizing eigenvectors and eigenvalues as axes of rotation or scaling."
  }
}

example {
  name: 201 Response
  description: Video created successfully
  
  request: {
    url: {{baseUrl}}/catalogs/:catalog_id/videos
    method: POST
    mode: json
    params:path: {
      catalog_id: 
    }
  
    body:json: {
      {
        "title": "",
        "url": "",
        "duration": 0,
        "description": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "title": "",
          "url": "",
          "duration": 0,
          "description": "",
          "id": 0,
          "catalog_id": 0,
          "created_at": "",
          "updated_at": "",
          "links": {}
        }
      '''
    }
  }
}

