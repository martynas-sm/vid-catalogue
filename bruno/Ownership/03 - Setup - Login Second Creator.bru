meta {
  name: 03 - Setup - Login Second Creator
  type: http
  seq: 3
  tags: [
    Ownership
  ]
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "username": "second_creator",
    "password": "Password123!"
  }
}

vars:post-response {
  second_creator_token: res.body.access_token
}

assert {
  res.status: eq 200
  res.body.access_token: isDefined
}

docs {
  Logs in secondary creator 'second_creator' and captures second_creator_token.
}
