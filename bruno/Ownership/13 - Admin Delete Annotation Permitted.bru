meta {
  name: 13 - Admin Delete Annotation Permitted
  type: http
  seq: 13
  tags: [
    Ownership
  ]
}

delete {
  url: {{baseUrl}}/catalogs/:catalog_id/videos/:video_id/annotations/:annotation_id
  body: none
  auth: inherit
}

params:path {
  catalog_id: 1
  video_id: 1
  annotation_id: {{owned_annotation_id}}
}

headers {
  Authorization: Bearer {{admin_token}}
}

assert {
  res.status: in [200, 204]
}

docs {
  Administrator deletes member's annotation via admin privilege override, expecting HTTP 200 or 204.
}
