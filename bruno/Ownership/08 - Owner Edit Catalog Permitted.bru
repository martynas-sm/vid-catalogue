meta {
  name: 08 - Owner Edit Catalog Permitted
  type: http
  seq: 8
  tags: [
    Ownership
  ]
}

put {
  url: {{baseUrl}}/catalogs/:catalog_id
  body: json
  auth: inherit
}

params:path {
  catalog_id: {{owned_catalog_id}}
}

headers {
  Authorization: Bearer {{owner_token}}
}

body:json {
  {
    "name": "Owner Updated Catalog",
    "description": "Legitimate update performed by resource owner",
    "is_public": true
  }
}

assert {
  res.status: eq 200
  res.body.name: eq Owner Updated Catalog
}

docs {
  Legitimate owner edits their own catalog, expecting HTTP 200 OK.
}
