meta {
  name: 07 - Second Creator Delete Catalog Forbidden
  type: http
  seq: 7
  tags: [
    Ownership
  ]
}

delete {
  url: {{baseUrl}}/catalogs/:catalog_id
  body: none
  auth: inherit
}

params:path {
  catalog_id: {{owned_catalog_id}}
}

headers {
  Authorization: Bearer {{second_creator_token}}
}

assert {
  res.status: eq 403
}

docs {
  Non-owner creator attempts to delete catalog owned by another creator, expecting HTTP 403 Forbidden.
}
