meta {
  name: 12 - Second Creator Delete Annotation Forbidden
  type: http
  seq: 12
  tags: [
    Ownership
  ]
}

delete {
  url: {{baseUrl}}/catalogs/:catalog_id/videos/:video_id/annotations/:annotation_id
  body: none
  auth: inherit
}

params:path {
  catalog_id: 1
  video_id: 1
  annotation_id: {{owned_annotation_id}}
}

headers {
  Authorization: Bearer {{second_creator_token}}
}

assert {
  res.status: eq 403
}

docs {
  Non-owner creator attempts to delete annotation owned by another creator, expecting HTTP 403 Forbidden.
}
