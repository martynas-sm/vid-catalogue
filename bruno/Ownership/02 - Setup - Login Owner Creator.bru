meta {
  name: 02 - Setup - Login Owner Creator
  type: http
  seq: 2
  tags: [
    Ownership
  ]
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "username": "martynas",
    "password": "Password123!"
  }
}

vars:post-response {
  owner_token: res.body.access_token
}

assert {
  res.status: eq 200
  res.body.access_token: isDefined
}

docs {
  Logs in initial creator 'martynas' and captures owner_token.
}
