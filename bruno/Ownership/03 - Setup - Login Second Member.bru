meta {
  name: 03 - Setup - Login Second Member
  type: http
  seq: 3
  tags: [
    Ownership
  ]
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "username": "second_member",
    "password": "Password123!"
  }
}

vars:post-response {
  second_member_token: res.body.access_token
}

assert {
  res.status: eq 200
  res.body.access_token: isDefined
}

docs {
  Logs in secondary member 'second_member' and captures second_member_token.
}
