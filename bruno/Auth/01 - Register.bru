meta {
  name: Register
  type: http
  seq: 1
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "username": "new_user",
    "email": "new_user@example.com",
    "password": "Password123!"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.username: eq new_user
  res.body.role: eq creator
}

docs {
  Registers a new user with Argon2id hashed password and default role 'creator'.
}
