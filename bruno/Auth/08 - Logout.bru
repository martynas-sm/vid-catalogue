meta {
  name: Logout
  type: http
  seq: 8
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/auth/logout
  body: json
  auth: inherit
}

body:json {
  {
    "refresh_token": "{{refresh_token}}"
  }
}

assert {
  res.status: in [200, 204]
}

docs {
  Revokes the active refresh token session in the database.
}
