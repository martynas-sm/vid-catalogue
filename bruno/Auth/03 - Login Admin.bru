meta {
  name: Login Admin
  type: http
  seq: 3
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "username": "adomas",
    "password": "Password123!"
  }
}

vars:post-response {
  admin_token: res.body.access_token
}

assert {
  res.status: eq 200
  res.body.access_token: isDefined
  res.body.token_type: eq bearer
}

docs {
  Authenticates administrator 'adomas' and stores admin_token in runtime variables.
}
