meta {
  name: Login Viewer
  type: http
  seq: 4
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "username": "viewer_user",
    "password": "Password123!"
  }
}

vars:post-response {
  viewer_token: res.body.access_token
}

assert {
  res.status: eq 200
  res.body.access_token: isDefined
  res.body.token_type: eq bearer
}

docs {
  Authenticates viewer role user 'viewer_user' and stores viewer_token.
}
