meta {
  name: Get composite catalog dashboard
  type: http
  seq: 6
  tags: [
    Catalogs
  ]
}

get {
  url: {{baseUrl}}/catalogs/:catalog_id/dashboard
  body: none
  auth: inherit
}

params:path {
  catalog_id: 1
}

