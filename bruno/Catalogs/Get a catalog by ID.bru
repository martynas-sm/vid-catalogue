meta {
  name: Get a catalog by ID
  type: http
  seq: 3
  tags: [
    Catalogs
  ]
}

get {
  url: {{baseUrl}}/catalogs/:catalog_id
  body: none
  auth: inherit
}

params:path {
  catalog_id: 1
}

