meta {
  name: Replace a catalog by ID
  type: http
  seq: 4
  tags: [
    Catalogs
  ]
}

put {
  url: {{baseUrl}}/catalogs/:catalog_id
  body: json
  auth: inherit
}

params:path {
  catalog_id: 1
}

body:json {
  {
    "name": "Linear Algebra (Revised)",
    "description": "Visual geometric intuition of vectors, matrices, determinants, and linear transformations",
    "is_public": true,
    "user_id": 1
  }
}

example {
  name: 200 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/catalogs/:catalog_id
    method: PUT
    mode: json
    params:path: {
      catalog_id: 
    }
  
    body:json: {
      {
        "name": "",
        "description": "",
        "is_public": false,
        "user_id": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "name": "",
          "description": "",
          "is_public": false,
          "id": 0,
          "user_id": "",
          "created_at": "",
          "updated_at": "",
          "links": {}
        }
      '''
    }
  }
}

