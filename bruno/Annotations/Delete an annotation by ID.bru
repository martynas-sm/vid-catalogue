meta {
  name: Delete an annotation by ID
  type: http
  seq: 5
  tags: [
    Annotations
  ]
}

delete {
  url: {{baseUrl}}/catalogs/:catalog_id/videos/:video_id/annotations/:annotation_id
  body: none
  auth: inherit
}

params:path {
  catalog_id: 1
  video_id: 1
  annotation_id: 4
}

example {
  name: 204 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/catalogs/:catalog_id/videos/:video_id/annotations/:annotation_id
    method: DELETE
    mode: none
    params:path: {
      catalog_id: 
      video_id: 
      annotation_id: 
    }
  }
  
  response: {
    status: {
      code: 204
      text: No Content
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 404 Response
  description: Annotation not found in scoped video
  
