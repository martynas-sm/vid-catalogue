meta {
  name: Create a new annotation for a video
  type: http
  seq: 2
  tags: [
    Annotations
  ]
}

post {
  url: {{baseUrl}}/catalogs/:catalog_id/videos/:video_id/annotations
  body: json
  auth: inherit
}

params:path {
  catalog_id: 1
  video_id: 1
}

body:json {
  {
    "text": "Summary of 3D determinant computation formula",
    "from_dur": 451.0,
    "to_dur": 558.0
  }
}

example {
  name: 201 Response
  description: Annotation created successfully
  
  request: {
    url: {{baseUrl}}/catalogs/:catalog_id/videos/:video_id/annotations
    method: POST
    mode: json
    params:path: {
      catalog_id: 
      video_id: 
    }
  
    body:json: {
      {
        "text": "",
        "from_dur": 0,
        "to_dur": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "text": "",
          "from_dur": 0,
          "to_dur": 0,
          "id": 0,
          "video_id": 0,
          "created_at": "",
          "updated_at": "",
          "links": {}
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Catalog or video not found
  
  request: {
    url: {{baseUrl}}/catalogs/:catalog_id/videos/:video_id/annotations
    method: POST
    mode: json
    params:path: {
      catalog_id: 
      video_id: 
    }
  
    body:json: {
      {
        "text": "",
        "from_dur": 0,
        "to_dur": 0
      }
    }
  }
  
  response: {
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 422 Response
  description: Validation Error
  
  request: {
    url: {{baseUrl}}/catalogs/:catalog_id/videos/:video_id/annotations
    method: POST
    mode: json
    params:path: {
      catalog_id: 
      video_id: 
    }
  
    body:json: {
      {
        "text": "",
        "from_dur": 0,
        "to_dur": 0
      }
    }
  }
  
  response: {
    headers: {
